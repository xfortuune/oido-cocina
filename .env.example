# Copia este archivo como .env y rellénalo (el .env no se sube a git).
# Los dos valores están en el Discord Developer Portal > tu aplicación > OAuth2.

# ID de cliente (Client ID). Es público: el navegador lo necesita para el SDK de Discord.
VITE_DISCORD_CLIENT_ID=

# Secreto de cliente (Client Secret). ¡Privado! Solo lo usa el servidor.
DISCORD_CLIENT_SECRET=

# Puerto del servidor de juego (por defecto 2567). En producción también vale PORT.
# SERVER_PORT=2567

# Pon 1 al desplegar para que solo se pueda jugar desde Discord (sin invitados por navegador).
# REQUIRE_DISCORD=0

# Pon 1 mientras pruebas en Discord con cloudflared, para que la recarga en caliente de Vite
# funcione a través del túnel (HTTPS, puerto 443).
# DISCORD_TUNNEL=0
